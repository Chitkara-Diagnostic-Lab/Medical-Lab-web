// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  emailVerified Boolean       @default(false)
  name          String
  PhoneNumber   String?
  image         String?
  role          Role          @default(USER)
  sessions      Session[]
  accounts      Account[]
  appointments  Appointment[]
  payments      Payment[]
  auditLogs     AuditLog[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Test {
  id               String            @id @default(cuid())
  name             String
  description      String?
  price            Float
  duration         Int
  category         String
  isActive         Boolean           @default(true)
  slots            Timeslot[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  appointmentItems AppointmentItem[]

  @@index([isActive, category])
  @@map("test")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model Appointment {
  id                String            @id @default(cuid())
  appointmentNumber String            @unique @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  slotId            String
  slot              Timeslot          @relation(fields: [slotId], references: [id])
  status            BookingStatus     `@default`(PENDING)
  totalAmount       Float
  notes             String?
  items             AppointmentItem[]
  payment           Payment?
  createdAt         DateTime          `@default`(now())
  updatedAt         DateTime          `@updatedAt`
  report            Report?

  @@index([userId, slotId])
  @@map("appointment")
  @@map("appointment")
}

model AppointmentItem {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  testId        String
  test          Test        @relation(fields: [testId], references: [id])
  price         Float
  createdAt     DateTime    @default(now())

  @@unique([appointmentId, testId])
  @@map("appointment_item")
}

model Timeslot {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  startTime String
  endTime   String

  currentPatients Int     @default(0)
  maxPatients     Int     @default(2)
  isActive        Boolean @default(true)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  test      Test?    @relation(fields: [testId], references: [id])
  testId    String?

  @@unique([date, startTime])
  @@map("timeslot")
}

model Report {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  fileUrl  String
  fileName String
  fileSize Int?
  remarks  String? @db.Text

  uploadedBy String
  replacedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("report")
}

model Payment {
  id              String      @id @default(cuid())
  appointmentId   String      @unique
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  amount          Float
  currency        String      @default("INR")
  provider        String
  providerTxnId   String?     @unique
  isPaid          Boolean     @default(false)
  paidAt          DateTime?
  webhookVerified Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerTxnId])
  @@index([isPaid])
}

model AuditLog {
  id        String    @id @default(cuid())
  actorType ActorType
  actorId   String?
  user      User?     @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  reason    String?
  metadata  Json?
  createdAt DateTime  `@default`(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([entity, entityId])
  @@map("audit_log")
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum ActorType {
  USER
  SYSTEM
}
